# NovaBid backend орчны хувьсагч (энэ файлыг .env болгож хуулна)
# Локал хөгжүүлэлтэд default утга ажиллах тул заавал биш.

# Серверийн порт
PORT=4000

# JWT токены нууц түлхүүр — production дээр ЗААВАЛ санамсаргүй утгаар солино!
JWT_SECRET=novabid-dev-secret-change-me

# Google-ээр нэвтрэх. Frontend-ийн VITE_GOOGLE_CLIENT_ID-тай ИЖИЛ утга байх ёстой —
# сервер ирсэн ID token-ы `aud`-ыг үүгээр шалгадаг. Хоосон бол endpoint 503 буцаана.
# Client secret ХЭРЭГГҮЙ (ID token урсгал ашигладаг).
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# --- Production (Docker/NAS) ---

# SQLite болон байршуулсан зураг хадгалах хавтас. Өгөөгүй бол server/data.
# DATA_DIR=/srv/data

# Frontend-ийн build хаана байгаа. Өгөөгүй бол server/public.
# index.html байхгүй бол статик үйлчилгээ идэвхжихгүй (dev-д Vite үйлчилдэг).
# WEB_ROOT=/srv/public

# Эхлэхэд админ бүртгэл үүсгэнэ/шинэчилнэ. Production-д demo seed-ийн оронд үүнийг ашиглана.
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=

# NODE_ENV=production үед JWT_SECRET заавал байх ёстой — үгүй бол сервер асахгүй.
