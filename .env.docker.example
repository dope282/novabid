# NovaBid — Docker/NAS deploy-ийн орчны хувьсагч
# Энэ файлыг `.env` болгож хуулаад docker compose ажиллуулна:
#   cp .env.docker.example .env

# NAS дээр гаднаас нээгдэх порт. Reverse proxy-гийн ард бол 127.0.0.1:4000 болгож
# зөвхөн дотогшоо нээж болно (доорх docker-compose-ын ports мөрийг харна уу).
HOST_PORT=4000

# ЗААВАЛ. Санамсаргүй урт утга — үүнгүйгээр сервер асахгүй.
# Үүсгэх: openssl rand -base64 48
JWT_SECRET=

# Эхний ажиллуулахад админ бүртгэл үүснэ (дараа нь нууц үг солиход дахин өгнө).
# Demo seed ажиллуулах ШААРДЛАГАГҮЙ — тэр нь нийтэд мэдэгдэх нууц үгтэй бүртгэл үүсгэдэг.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=

# Google-ээр нэвтрэх (заавал биш). Хоосон бол тэр товч харагдахгүй.
# Google Cloud Console дээр Authorized JavaScript origins-д домэйноо нэмнэ.
# Энэ утга build үед frontend рүү шингэдэг тул өөрчилвөл image-ыг ДАХИН build хийнэ.
GOOGLE_CLIENT_ID=
