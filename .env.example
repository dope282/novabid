# NovaBid frontend орчны хувьсагч (энэ файлыг .env.local болгож хуулна)
# Локал хөгжүүлэлтэд default утга ажиллах тул заавал биш.
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws

# Google-ээр нэвтрэх. Хоосон бол тэр товч харагдахгүй (имэйл+нууц үг хэвээр ажиллана).
# Google Cloud Console → OAuth 2.0 Client ID (Web application) -аас авна.
# Энэ утга нууц биш — frontend-д ил гардаг. Backend-д мөн ижил утгыг тавина.
# VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
